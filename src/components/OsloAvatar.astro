---
// Oslo, le bouvier de l'Entlebuch : icône du site, une expression par contexte.
import { getImage } from 'astro:assets';
import heureux from '../assets/oslo/heureux.jpg';
import joyeux from '../assets/oslo/joyeux.jpg';
import clinOeil from '../assets/oslo/clin-oeil.jpg';
import bravo from '../assets/oslo/bravo.jpg';
import surpris from '../assets/oslo/surpris.jpg';
import curieux from '../assets/oslo/curieux.jpg';
import triste from '../assets/oslo/triste.jpg';
import chiot from '../assets/oslo/chiot.jpg';
import fier from '../assets/oslo/fier.jpg';

const all = { heureux, joyeux, 'clin-oeil': clinOeil, bravo, surpris, curieux, triste, chiot, fier };
export type OsloMood = keyof typeof all;

interface Props { size?: number; class?: string; mood?: OsloMood }
const { size = 120, class: cls, mood = 'heureux' } = Astro.props;
const img = await getImage({ src: all[mood] ?? heureux, width: Math.min(320, Math.round(size * 2)), format: 'webp' });
---
<img
  class:list={['oslo', cls]}
  src={img.src}
  width={size}
  height={size}
  alt=""
  decoding="async"
  loading="lazy"
  style={`--s:${size}px`}
/>

<style>
  .oslo { display: inline-block; width: var(--s); height: var(--s); flex: none; border-radius: 50%; object-fit: cover; background: var(--stone2); box-shadow: 0 0 0 2px var(--white), 0 0 0 3px var(--line); vertical-align: middle; }
</style>
