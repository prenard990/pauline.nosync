---
import OsloAvatar from '../components/OsloAvatar.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import OsloTip from '../components/OsloTip.astro';
import { temoignages } from '../data/temoignages';
---
<Layout title="Témoignages" description="Les familles accompagnées par Pauline Renard, éducateur canin et comportementaliste à Lyon, racontent leur expérience.">
  <PageHero mood="joyeux" label="Témoignages" title="Ils ont fait <em>un bout de chemin</em> avec nous." lead="Chiots, chiens réactifs, anxieux ou simplement pleins d’énergie : des familles racontent comment le quotidien avec leur chien a évolué." />

  <section>
    <div class="w">
      <div class="quotes" data-reveal="stagger">
        {temoignages.map((t) => (
          <figure class="card quote">
            {t.exemple && <span class="ex-tag">Exemple</span>}
            {t.source && <span class="src-tag">Avis {t.source}</span>}
            <span class="motif">{t.motif}</span>
            <blockquote><p>{t.texte}</p></blockquote>
            <figcaption>
              <span class="ini" aria-hidden="true">{t.chien.charAt(0)}</span>
              <span><strong>{t.prenom}</strong> &amp; {t.chien}<small>{t.race}</small></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-stone">
    <div class="w narrow center-box">
      <div class="osl-say"><OsloAvatar size={120} mood="joyeux" /><p class="label osl-bub">À votre tour</p></div>
      <h2 data-split>Et si on écrivait <em>votre histoire</em> ?</h2>
      <p class="lead" data-reveal>Tout commence par un bilan pour faire connaissance avec votre chien et comprendre vos besoins.</p>
      <OsloTip mood="heureux"><p>Vous avez déjà été accompagné·e par ma maîtresse ? Envoyez-lui quelques mots, elle sera ravie de les partager ici !</p></OsloTip>
    </div>
  </section>
</Layout>

<style>
  .quotes { columns: 1; column-gap: 20px; }
  @media (min-width: 700px) { .quotes { columns: 2; } }
  @media (min-width: 1100px) { .quotes { columns: 3; } }
  .quote { position: relative; break-inside: avoid; margin: 0 0 20px; display: flex; flex-direction: column; gap: 18px; }
  .ex-tag { position: absolute; top: 18px; right: 18px; font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #8a5a00; background: #fff1d6; padding: 4px 9px; border-radius: 999px; }
  .src-tag { position: absolute; top: 18px; right: 18px; font-size: .72rem; color: var(--ink3); }
  .motif { font-size: .76rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sage); padding-right: 80px; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font-family: var(--display); font-size: 1.15rem; line-height: 1.5; letter-spacing: -.01em; }
  blockquote p::before { content: '« '; color: var(--sage); }
  blockquote p::after { content: ' »'; color: var(--sage); }
  figcaption { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .95rem; }
  figcaption small { display: block; color: var(--ink3); font-size: .85rem; }
  .ini { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--sage-l); color: var(--sage-d); font-family: var(--display); font-weight: 600; }
  .center-box { text-align: center; }
  .center-box :global(.tip), .center-box :global(aside) { text-align: left; }
</style>
