---
import OsloAvatar from '../components/OsloAvatar.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import OsloTip from '../components/OsloTip.astro';
import { site, prices, freeCall } from '../data/site';
import { stages } from '../data/groups';
import { breeds } from '../data/breeds';
// liste de races proposée dans le formulaire (sans doublons, par ordre alphabétique)
const breedNames = [...new Set(breeds.map((b) => b.name))].sort((a, b) => a.localeCompare(b, 'fr'));
// « Votre besoin » : options regroupées. `alias` = valeurs envoyées par les liens du site (?motif=…)
// pour présélectionner la bonne option.
const motifGroups = [
  { label: 'Pour commencer', options: [
    { text: `Bilan gratuit de ${freeCall.duration} (téléphone ou visio)`, alias: ['Bilan gratuit'] },
    { text: 'Bilan complet (1h30 à 2h chez vous)', alias: ['Bilan comportemental', 'Séance bilan', 'Bilan complet'] },
    { text: 'Une question avant de me lancer', alias: [] },
  ] },
  { label: 'Ce qui vous amène', options: [
    { text: 'Éducation de base (laisse, rappel, bonnes habitudes)', alias: ['Éducation de base'] },
    { text: 'Arrivée d’un chiot ou d’un chien adopté', alias: ['Chiot & nouvel arrivant', 'Chiot'] },
    { text: 'Réactivité en balade (chiens, humains, vélos…)', alias: ['Réactivité'] },
    { text: 'Difficulté à rester seul', alias: ['Anxiété de séparation'] },
    { text: 'Protection de ressources (jouets, gamelle…)', alias: ['Protection de ressources'] },
    { text: 'Autre comportement difficile (aboiements, destructions, fugues…)', alias: ['Comportements problématiques'] },
    { text: 'Changement de vie (bébé, déménagement, nouvel animal)', alias: ['Changements de vie'] },
  ] },
  { label: 'En groupe', options: [
    { text: 'Balades collectives', alias: ['Balade collective'] },
  ] },
];
---
<Layout footerCta={false} title="Contact" description="Contactez Pauline Renard, éducateur canin à Lyon 7 : décrivez votre situation ou réservez un bilan gratuit de 30 minutes par téléphone ou en visio.">
  <PageHero mood="heureux" label="Écrivez à ma maîtresse" title="Parlons de <em>votre chien</em>." lead="Décrivez-moi votre situation, je reviens vers vous rapidement. Vous hésitez encore ? Choisissez le bilan gratuit de 30 minutes, par téléphone ou en visio." />

  <section>
    <div class="w layout">
      <aside class="side" data-reveal="stagger">
        <a class="ct" href={`mailto:${site.email}`}><span class="icon-c"><Icon name="mail" size={20} /></span><span><small>E-mail</small><strong>{site.email}</strong></span></a>
        <div class="ct"><span class="icon-c"><Icon name="pin" size={20} /></span><span><small>Zone d’intervention</small><strong>{site.location}</strong></span></div>
        <OsloTip title="Bon à savoir"><p>Le <strong>bilan gratuit</strong> (30 min, par téléphone ou en visio) permet de faire connaissance : ma maîtresse vous indique les points à travailler et vous propose un échéancier de séances. Le <strong>bilan complet à 40 €</strong>, chez vous, est ensuite indispensable pour démarrer le travail.</p></OsloTip>
      </aside>

      <div class="form-card" data-reveal>
        <form id="f" novalidate>
          <div class="two">
            <label>Votre nom<input name="nom" required autocomplete="name" /></label>
            <label>Votre e-mail<input type="email" name="email" required autocomplete="email" /></label>
          </div>
          <div class="two">
            <label><span>Téléphone <span class="opt">(facultatif)</span></span><input type="tel" name="tel" autocomplete="tel" /></label>
            <label>Nom du chien<input name="chien_nom" placeholder="Ex. : Oslo" autocomplete="off" /></label>
          </div>
          <div class="two">
            <label>Son âge<select name="chien_age" id="chien_age"><option value="">Choisir…</option>{stages.map((s) => <option>{s.label}</option>)}</select></label>
            <label>Sa race<input name="chien_race" list="contact-breeds" placeholder="Tapez pour chercher : bouvier, croisé…" autocomplete="off" /></label>
          </div>
          <datalist id="contact-breeds">
            <option value="Croisé / je ne sais pas" />
            {breedNames.map((b) => <option value={b} />)}
          </datalist>
          <div class="two">
            <label>Votre besoin<select name="motif" id="motif" required>
              <option value="" disabled selected>Choisissez ce qui vous correspond…</option>
              {motifGroups.map((g) => (
                <optgroup label={g.label}>{g.options.map((o) => <option data-alias={o.alias.join('|')}>{o.text}</option>)}</optgroup>
              ))}
              <option data-alias="Autre">Autre demande</option>
            </select></label>
            <label>Formule envisagée<select name="offre" id="offre"><option>Je ne sais pas encore</option><option>{freeCall.name}</option>{prices.map((p, i) => <option data-alias={i === 0 ? 'Séance bilan' : ''}>{p.name}</option>)}</select></label>
          </div>
          <!-- visible seulement si le bilan gratuit est choisi (motif ou formule) -->
          <fieldset class="free" id="free" hidden>
            <legend>Votre bilan gratuit de {freeCall.duration}</legend>
            <div class="two">
              <div class="choice" role="radiogroup" aria-label="Je préfère être contacté·e">
                <span class="cl">Je préfère</span>
                <label class="radio"><input type="radio" name="canal" value="Téléphone" checked /> Par téléphone</label>
                <label class="radio"><input type="radio" name="canal" value="Visio" /> En visio</label>
              </div>
              <label><span>Mes disponibilités <span class="opt">(facultatif)</span></span><input name="dispos" placeholder="Ex. : en semaine après 18 h, samedi matin" autocomplete="off" /></label>
            </div>
            <p class="free-note">{freeCall.note}</p>
          </fieldset>
          <label>Votre message<textarea name="msg" rows="6" required placeholder="Depuis quand, dans quels contextes, ce que vous avez déjà essayé…"></textarea></label>
          <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn sage" type="submit"><span class="lbl">Envoyer ma demande</span> <Icon name="arrow" size={17} /></button>
          <p class="msg" id="ok" role="status" aria-live="polite"></p>
          <p class="privacy">Vos informations servent uniquement à répondre à votre demande. Elles ne sont ni revendues, ni utilisées à d’autres fins, et vous pouvez demander leur suppression à tout moment par e-mail.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-stone">
    <div class="w narrow">
      <div class="head center"><div class="osl-say"><OsloAvatar size={120} mood="surpris" /><p class="label osl-bub">Questions fréquentes</p></div><h2 data-split>Avant de me contacter</h2></div>
      <Faq />
    </div>
  </section>
</Layout>

<style>
  .layout { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 980px) { .layout { grid-template-columns: .8fr 1.2fr; gap: 64px; } .side { position: sticky; top: 110px; } }
  .side { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .ct { display: flex; gap: 16px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--line); text-decoration: none; overflow-wrap: anywhere; }
  a.ct:hover strong { color: var(--sage); }
  .ct small { display: block; font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink3); }
  .ct strong { font-weight: 500; transition: color .2s; }
  .form-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(26px, 4vw, 44px); }
  form { display: grid; gap: 20px; }
  .two { display: grid; gap: 20px; }
  @media (min-width: 620px) { .two { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 8px; font-weight: 500; font-size: .9rem; }
  .opt { font-weight: 400; color: var(--ink3); }
  input, select, textarea { font: inherit; font-weight: 400; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); width: 100%; transition: border-color .2s, box-shadow .2s, background .2s; }
  @media (max-width: 760px) { input, select, textarea { font-size: 16px; } } /* évite le zoom automatique de Safari sur iPhone */
  input:focus, select:focus, textarea:focus { outline: none; background: var(--white); border-color: var(--sage); box-shadow: 0 0 0 3px var(--sage-l); }
  .invalid { border-color: var(--clay) !important; background: var(--clay-l) !important; }
  .hp { position: absolute; left: -9999px; }
  .free { margin: 0; padding: 20px; border: 1px solid var(--sage); border-radius: var(--r); background: var(--sage-l); display: grid; gap: 14px; }
  .free legend { padding: 0 8px; font-weight: 600; color: var(--sage-d); }
  .choice { display: grid; gap: 8px; align-content: start; font-size: .9rem; }
  .cl { font-weight: 500; }
  .radio { display: flex; align-items: center; gap: 10px; font-weight: 400; cursor: pointer; }
  .radio input { width: auto; accent-color: var(--sage); }
  .free-note { margin: 0; font-size: .88rem; color: var(--ink2); }
  form .btn { justify-self: start; }
  form .btn[disabled] { opacity: .7; cursor: wait; }
  .msg { margin: 0; font-weight: 500; }
  .msg.ok { color: var(--sage); }
  .msg.err { color: var(--clay); }
  .msg.wait { color: var(--ink2); font-weight: 400; }
  .msg:empty { display: none; }
  .privacy { margin: 0; font-size: .82rem; line-height: 1.5; color: var(--ink3); }
</style>

<script>
  import { site } from '../data/site';
  import { stages } from '../data/groups';
  import { loadDog } from '../lib/dog';
  function init() {
    const f = document.querySelector<HTMLFormElement>('#f');
    if (!f) return;
    const q = new URLSearchParams(location.search);
    const pick = (id: string, v: string | null) => {
      const s = f.querySelector<HTMLSelectElement>(id);
      if (!s || !v) return;
      const opts = [...s.options].filter((o) => o.value !== '');
      const o = opts.find((o) => o.text === v || (o.dataset.alias ?? '').split('|').includes(v))
        ?? opts.find((o) => v.startsWith(o.text) || o.text.startsWith(v));
      if (o) s.value = o.value;
    };
    pick('#offre', q.get('offre'));
    pick('#motif', q.get('motif'));
    // bilan gratuit : bloc « téléphone ou visio » + disponibilités, et les deux listes restent cohérentes
    const motifEl = f.querySelector<HTMLSelectElement>('#motif')!;
    const offreEl = f.querySelector<HTMLSelectElement>('#offre')!;
    const freeEl = f.querySelector<HTMLFieldSetElement>('#free')!;
    const telEl = f.querySelector<HTMLInputElement>('[name=tel]')!;
    const isFree = () => motifEl.value.startsWith('Bilan gratuit') || offreEl.value === 'Bilan gratuit';
    const syncFree = () => {
      const on = isFree();
      freeEl.hidden = !on;
      const phone = on && f.querySelector<HTMLInputElement>('[name=canal]:checked')?.value === 'Téléphone';
      telEl.required = phone;
      telEl.closest('label')!.querySelector('.opt')!.textContent = phone ? '(pour vous appeler)' : '(facultatif)';
    };
    motifEl.addEventListener('change', () => {
      if (motifEl.value.startsWith('Bilan gratuit')) offreEl.value = 'Bilan gratuit';
      else if (offreEl.value === 'Bilan gratuit') offreEl.value = 'Je ne sais pas encore';
      syncFree();
    });
    offreEl.addEventListener('change', () => {
      if (offreEl.value === 'Bilan gratuit') pick('#motif', 'Bilan gratuit');
      else if (motifEl.value.startsWith('Bilan gratuit')) motifEl.value = '';
      syncFree();
    });
    f.querySelectorAll('[name=canal]').forEach((r) => r.addEventListener('change', syncFree));
    if (q.get('motif') === 'Bilan gratuit' || q.get('offre') === 'Bilan gratuit') { pick('#motif', 'Bilan gratuit'); offreEl.value = 'Bilan gratuit'; }
    syncFree();
    // préremplit le chien depuis l'adresse (chien_nom, chien_age, chien_race) ou le profil enregistré avec Oslo
    const dog = loadDog();
    const nomEl = f.querySelector<HTMLInputElement>('[name=chien_nom]')!;
    const raceEl = f.querySelector<HTMLInputElement>('[name=chien_race]')!;
    const ageKey = q.get('chien_age') || dog?.age || '';
    nomEl.value = q.get('chien_nom') || dog?.nom || '';
    raceEl.value = q.get('chien_race') || dog?.race || '';
    pick('#chien_age', stages.find((s) => s.key === ageKey)?.label ?? null);

    const ok = f.querySelector<HTMLElement>('#ok')!;
    // un champ signalé en rouge redevient normal dès qu'il est correctement rempli
    f.querySelectorAll<HTMLInputElement>('[required], [name=tel]').forEach((el) =>
      el.addEventListener('input', () => { if (el.checkValidity()) el.classList.remove('invalid'); }));
    const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const lbl = btn.querySelector<HTMLElement>('.lbl')!;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      let valid = true;
      f.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
        const bad = !el.checkValidity();
        el.classList.toggle('invalid', bad);
        if (bad && valid) { el.focus(); valid = false; }
      });
      if (!valid) { ok.className = 'msg err'; ok.textContent = 'Merci de compléter les champs obligatoires.'; return; }
      const o: Record<string, string> = Object.fromEntries(new FormData(f) as any);
      if (o._honey) return;
      // bilan gratuit : le mode de contact et les disponibilités sont ajoutés en tête du message
      // (ainsi ils arrivent aussi bien dans l'e-mail que dans l'application « Mes bilans »)
      if (isFree()) o.msg = `[Bilan gratuit – ${o.canal === 'Visio' ? 'en visio' : 'par téléphone'}${o.dispos ? ` – disponibilités : ${o.dispos}` : ''}]\n\n${o.msg}`;
      delete o.canal; delete o.dispos;
      Object.assign(o, { _subject: `Nouvelle demande via le site – ${o.motif}`, _captcha: 'false', _template: 'table' });
      btn.disabled = true; lbl.textContent = 'Envoi en cours…'; ok.textContent = '';
      // si le service d'envoi est lent, on rassure le visiteur pour qu'il ne ferme pas la page
      const slow = window.setTimeout(() => {
        ok.className = 'msg wait';
        ok.textContent = 'Envoi en cours, merci de patienter et de ne pas fermer la page : cela peut prendre jusqu’à une minute.';
      }, 4000);
      // la demande est aussi enregistrée sur le site (worker/index.js) pour l'application « Mes bilans »
      const saved = fetch(site.demandesApi, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nom: o.nom, email: o.email, tel: o.tel, chien_nom: o.chien_nom, chien_age: o.chien_age, chien_race: o.chien_race, motif: o.motif, offre: o.offre, msg: o.msg }),
      }).then((r) => r.ok).catch(() => false);
      try {
        // Web3Forms (rapide) dès qu'une clé est renseignée dans site.ts, sinon FormSubmit
        const headers = { 'Content-Type': 'application/json', Accept: 'application/json' };
        const r = site.web3formsKey
          ? await fetch('https://api.web3forms.com/submit', {
              method: 'POST', headers,
              body: JSON.stringify({
                access_key: site.web3formsKey,
                subject: o._subject,
                from_name: 'Site Pauline Renard',
                replyto: o.email,
                'Nom': o.nom, 'E-mail': o.email, 'Téléphone': o.tel || '—',
                'Nom du chien': o.chien_nom || '—', 'Âge du chien': o.chien_age || '—', 'Race': o.chien_race || '—',
                'Besoin': o.motif, 'Formule envisagée': o.offre, 'Message': o.msg,
              }),
            })
          : await fetch(`https://formsubmit.co/ajax/${site.email}`, { method: 'POST', headers, body: JSON.stringify(o) });
        // Les deux services peuvent répondre 200 avec success « false » (ex. formulaire non activé) : c'est un échec.
        const res = await r.json().catch(() => ({}));
        // l'envoi est réussi si l'e-mail est parti OU si la demande est enregistrée sur le site
        if ((!r.ok || String(res.success) !== 'true') && !(await saved)) throw new Error(res.message);
        ok.className = 'msg ok'; ok.textContent = 'Merci ! Votre message a bien été envoyé, je vous réponds rapidement. 🐶';
        f.reset(); syncFree();
      } catch {
        if (await saved) { ok.className = 'msg ok'; ok.textContent = 'Merci ! Votre message a bien été envoyé, je vous réponds rapidement. 🐶'; f.reset(); syncFree(); return; }
        ok.className = 'msg err'; ok.textContent = `L’envoi a échoué. Écrivez-moi directement à ${site.email} ou réessayez dans quelques minutes.`;
      } finally {
        window.clearTimeout(slow);
        btn.disabled = false; lbl.textContent = 'Envoyer ma demande';
      }
    });
  }
  init();
</script>
