---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import LIcon from '../components/LIcon.astro';
import OsloAvatar from '../components/OsloAvatar.astro';
import DogFinder from '../components/DogFinder.astro';
import { temoignages } from '../data/temoignages';
import { site, zones, freeCall, prices, bilanWhy } from '../data/site';
import heroPhoto from '../assets/photos/pauline-oslo-prairie.jpg';

const situations = [
  {
    icon: 'route', title: 'Des balades parfois compliquées', href: '/prestations/#comportement',
    signs: ['Il tire en laisse', 'Il réagit aux autres chiens', 'Il revient difficilement une fois détaché'],
    piste: 'Derrière ces comportements, il y a souvent une émotion (peur, frustration, excitation), un besoin d’explorer ou un apprentissage encore à construire.',
  },
  {
    icon: 'sprout', title: 'L’arrivée d’un chiot', href: '/prestations/#chiot',
    signs: ['Propreté', 'Solitude', 'Mordillements', 'Découverte du monde'],
    piste: 'Les premiers mois posent les bases de toute sa vie : on l’accompagne dès le départ, à son rythme et en respectant sa personnalité.',
  },
  {
    icon: 'house', title: 'Des moments difficiles à la maison', href: '/prestations/#comportement',
    signs: ['Destructions', 'Aboiements', 'Difficulté à rester seul', 'Protection de ses ressources'],
    piste: 'Ce sont autant de signaux qui expriment un besoin ou un mal-être : ils méritent d’être compris avant d’être corrigés.',
  },
  {
    icon: 'ear', title: 'Le sentiment de ne pas se comprendre', href: '/prestations/#education',
    signs: ['Vous avez l’impression d’avoir tout essayé', 'Il est moins disponible dès qu’il y a des distractions'],
    piste: 'Il s’agit souvent de trouver un langage commun, et de devenir pour lui un repère plus intéressant que tout ce qui l’entoure.',
  },
];

const offers = [
  { n: '01', tag: 'Point de départ', title: 'Le bilan comportemental', text: 'Une rencontre de 1h30 à 2h chez vous pour analyser l’environnement de votre chien, comprendre l’origine de ses problématiques et établir un plan d’action personnalisé.', href: '/prestations/#tarifs', cta: 'Voir le tarif', icon: 'list' },
  { n: '02', tag: 'Séances individuelles', title: 'Éducation & rééducation', text: 'Des séances sur-mesure réalisées à votre domicile ou en extérieur selon vos besoins et la problématique ciblée (rappels, marche en laisse, gestion des émotions, désensibilisation en ville ou en milieu naturel).', href: '/prestations/#accompagnements', cta: 'Les accompagnements', icon: 'target' },
  { n: '03', tag: 'Sessions collectives', title: 'École du chiot & balades éducatives', text: 'Apprendre les codes canins en toute sécurité, développer sa confiance et renforcer votre complicité au contact de chiens équilibrés lors de sessions collectives.', href: '/prestations/#balades', cta: 'Les balades collectives', icon: 'users' },
];


// Seuls les vrais avis s’affichent (les exemples sont réservés à la future page Témoignages).
const avis = temoignages.filter((t) => !t.exemple).slice(0, 3);
---
<Layout
  description="Pauline Renard, éducateur canin et comportementaliste à Lyon : bilan comportemental, éducation et rééducation à domicile, école du chiot et balades éducatives. Lyon, Villeurbanne, Caluire, Tassin, Meyzieu."
  image={heroPhoto}
  footerCta={false}
>
  <!-- 1. HERO -->
  <section class="hero" data-hero>
    <div class="w hero-grid">
      <div class="hero-txt">
        <div class="hero-head">
          <h1 data-split>Éducatrice et comportementaliste canin <em>à Lyon</em> et alentours</h1>
          <div class="hero-mini" aria-hidden="true"><Image src={heroPhoto} alt="" widths={[160, 240]} sizes="120px" loading="eager" /></div>
        </div>
        <p class="lead" data-reveal>Retrouvez une relation sereine et complice avec votre chien grâce à une approche bienveillante, respectueuse de ses émotions et adaptée à votre quotidien.</p>
        <div class="btns" data-reveal>
          <a class="btn sage" href={`/contact/?motif=${encodeURIComponent('Bilan comportemental')}`}>Réserver un bilan comportemental <Icon name="arrow" size={17} /></a>
          <a class="btn ghost" href="#accompagnements">Découvrir mes accompagnements</a>
        </div>
        <ul class="trust" data-reveal="stagger">
          <li><LIcon name="cap" size={20} /> Diplômée EFM · ACACED</li>
          <li><LIcon name="handheart" size={20} /> Méthodes bienveillantes</li>
          <li><LIcon name="house" size={20} /> À domicile et en extérieur</li>
        </ul>
      </div>
      <div class="hero-visual">
        <div class="photo hero-img" data-img>
          <Image src={heroPhoto} alt="Pauline Renard, éducateur canin à Lyon, accroupie dans une prairie ensoleillée avec son chien Oslo, bouvier de l’Entlebuch" widths={[480, 800]} sizes="(min-width: 1000px) 480px, 90vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="oslo-card" data-reveal>
          <OsloAvatar size={42} mood="joyeux" />
          <span><strong>Ma maîtresse et moi en balade</strong>Lyon et alentours</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. VOUS VOUS RECONNAISSEZ ? -->
  <section class="bg-stone sits-s">
    <div class="w">
      <div class="head narrow-head">
        <div class="osl-say"><OsloAvatar size={120} mood="surpris" /><p class="label osl-bub">Vous vous reconnaissez ?</p></div>
        <h2 data-split>Vivre avec un chien devrait être un plaisir, <em>pas une source de stress</em> au quotidien</h2>
        <p class="lead" data-reveal>Que vous veniez d’accueillir un chiot ou que vous rencontriez des difficultés avec votre chien adulte, chaque comportement a une explication. Je vous aide à décrypter ses besoins pour avancer ensemble, sans rapport de force.</p>
      </div>
      <div class="sits" data-reveal="stagger">
        {situations.map((s) => (
          <article class="card sit">
            <div class="sit-head">
              <span class="icon-c"><LIcon name={s.icon} /></span>
              <h3>{s.title}</h3>
            </div>
            <ul class="signs" aria-label="Ce que vous observez">
              {s.signs.map((t) => <li>{t}</li>)}
            </ul>
            <details class="piste" data-open-wide>
              <summary class="piste-l"><LIcon name="bulb" size={16} /> Piste de compréhension</summary>
              <p>{s.piste}</p>
            </details>
            <a class="sit-more" href={s.href}>En savoir plus <Icon name="arrow" size={15} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. MES ACCOMPAGNEMENTS -->
  <section id="accompagnements" class="anchor offers-s">
    <div class="w">
      <div class="head narrow-head">
        <div class="osl-say"><OsloAvatar size={120} mood="bravo" /><p class="label osl-bub">Les accompagnements de ma maîtresse</p></div>
        <h2 data-split>Un accompagnement <em>sur-mesure</em> à domicile et en extérieur</h2>
      </div>
      <div class="offers" data-reveal="stagger">
        {offers.map((o, i) => (
          <article class:list={['card', 'offer', { first: i === 0 }]}>
            <div class="o-top">
              <span class="icon-c"><LIcon name={o.icon} /></span>
              <span class="o-n">{o.n}</span>
            </div>
            <p class="o-tag">{o.tag}</p>
            <h3>{o.title}</h3>
            <p class="o-txt">{o.text}</p>
            <a class="link" href={o.href}>{o.cta} <Icon name="arrow" size={15} /></a>
          </article>
        ))}
      </div>
      <p class="center more-p"><a class="btn ghost" href="/prestations/">Toutes les prestations et tarifs <Icon name="arrow" size={17} /></a></p>
    </div>
  </section>

  <!-- 4. BILAN GRATUIT (après les accompagnements) -->
  <section class="free-s" id="bilan-gratuit">
    <div class="w">
      <div class="free-card" data-reveal>
        <div class="free-main">
          <div class="osl-say"><OsloAvatar size={120} mood="joyeux" /><p class="label osl-bub">Bilan gratuit · {freeCall.duration}</p></div>
          <h2 data-split>Vous hésitez encore ? <em>Faites un premier bilan gratuit.</em></h2>
          <p class="lead">30 minutes {freeCall.where} pour me parler de votre chien et des difficultés que vous rencontrez. À la fin de l’échange, je vous dis ce que nous aurions à travailler ensemble et je vous propose un échéancier de séances.</p>
          <ul class="free-meta" aria-label="En pratique">
            <li><LIcon name="clock" size={18} /> {freeCall.duration}</li>
            <li><LIcon name="phone" size={18} /> Téléphone</li>
            <li><LIcon name="video" size={18} /> ou visio</li>
            <li><LIcon name="gift" size={18} /> Gratuit, sans engagement</li>
          </ul>
          <div class="btns">
            <a class="btn sage" href={`/contact/?motif=${encodeURIComponent('Bilan gratuit')}&offre=${encodeURIComponent('Bilan gratuit')}`}>Réserver mon bilan gratuit <Icon name="arrow" size={17} /></a>
            <a class="link free-more" href="/prestations/#bilan">Bilan gratuit ou bilan complet ? <Icon name="arrow" size={15} /></a>
          </div>
        </div>
        <div class="free-side">
          <p class="free-t">Pendant ces 30 minutes</p>
          <ul class="check">{freeCall.features.map((f) => <li>{f}</li>)}</ul>
          <div class="free-next">
            <p class="free-t">Et ensuite ?</p>
            <p>{bilanWhy} <a href="/prestations/#bilan">Découvrir le bilan complet ({prices[0].price} €) →</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. GUIDE D'OSLO (formulaire affiché à la demande) -->
  <section class="finder-s">
    <div class="w">
      <div class="finder" id="mon-chien" data-reveal>
        <div class="finder-intro">
          <div class="fc-head"><OsloAvatar size={44} mood="curieux" /><span>Le guide d’Oslo</span></div>
          <h3>Comprendre ce qui compte pour lui</h3>
          <p>Présentez votre chien à Oslo (nom, âge, race) : il vous donne des pistes pour mieux comprendre ses besoins.</p>
          <button class="btn sage" type="button" data-finder-open aria-controls="finder-form" aria-expanded="false">Découvrir ses besoins <Icon name="arrow" size={17} /></button>
        </div>
        <div class="finder-form" id="finder-form" hidden><DogFinder /></div>
      </div>
    </div>
  </section>

  <!-- 6. AVIS CLIENTS (masqué tant qu'il n'y a aucun vrai avis) -->
  {avis.length > 0 && <section>
    <div class="w">
      <div class="row-head">
        <div>
          <div class="osl-say"><OsloAvatar size={120} mood="joyeux" /><p class="label osl-bub">Avis clients</p></div>
          <h2 data-split>Ils ont retrouvé des <em>balades sereines</em></h2>
        </div>
      </div>
      <div class:list={['reviews', `n${avis.length}`]} data-reveal="stagger">
        {avis.map((t) => (
          <figure class="card review">
            <div class="r-top">
              <span class="stars" role="img" aria-label="5 étoiles sur 5">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</span>
              {t.exemple ? <span class="ex-tag">Exemple</span> : <span class="g">{t.source ? `Avis ${t.source}` : 'Avis client'}</span>}
            </div>
            <blockquote><p>{t.texte}</p></blockquote>
            <figcaption>
              <span class="ini" aria-hidden="true">{t.prenom.charAt(0)}</span>
              <span><strong>{t.prenom}</strong> &amp; {t.chien}<small>{t.race} · {t.motif}</small></span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="center more-p"><a class="btn ghost" href={site.reviewUrl} target="_blank" rel="noopener">Vous avez été accompagné·e ? Laissez un avis <Icon name="arrow" size={17} /></a></p>
    </div>
  </section>}

  <!-- 7. ZONE D'INTERVENTION & CONTACT -->
  <section class="final-s">
    <div class="w">
      <div class="final">
        <div>
          <h2 data-split>Prêt à commencer <em>avec votre chien</em> ?</h2>
          <p class="zones-l"><LIcon name="pin" size={16} /> À domicile et en extérieur : {zones.join(', ')}.</p>
        </div>
        <div class="final-cta" data-reveal>
          <a class="btn light" href="/contact/">Me contacter <Icon name="arrow" size={17} /></a>
          <p class="reassure"><LIcon name="clock" size={16} /> Réponse sous 24h · 7j/7</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // guide d'Oslo : le formulaire ne s'affiche qu'au clic
  document.querySelectorAll<HTMLButtonElement>('[data-finder-open]').forEach((b) => b.addEventListener('click', () => {
    const f = document.getElementById(b.getAttribute('aria-controls')!);
    if (!f) return;
    f.hidden = false; b.setAttribute('aria-expanded', 'true'); b.hidden = true;
    f.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
  }));
  // pistes de compréhension : ouvertes sur grand écran, repliées sur téléphone
  if (matchMedia('(min-width: 760px)').matches) document.querySelectorAll<HTMLDetailsElement>('details[data-open-wide]').forEach((d) => (d.open = true));
</script>

<style>
  .anchor { scroll-margin-top: 90px; }
  /* respiration entre le guide d'Oslo et les accompagnements */
  .narrow-head { max-width: 820px; }
  .narrow-head .lead { margin-top: 22px; }

  /* 1. Hero */
  .hero { padding: clamp(32px, 6vw, 80px) 0 clamp(64px, 9vw, 120px); }
  .hero-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.4fr .6fr; gap: 64px; } }
  .hero h1 { font-size: clamp(2.3rem, 5.2vw, 4.4rem); margin-bottom: 26px; }
  .hero .lead { margin-bottom: 34px; max-width: 54ch; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 520px) { .btns .btn { width: 100%; justify-content: center; } }
  .trust { list-style: none; padding: 26px 0 0; margin: 40px 0 0; display: flex; flex-wrap: wrap; gap: 14px 30px; font-size: .92rem; color: var(--ink2); border-top: 1px solid var(--line); }
  .trust li { display: inline-flex; align-items: center; gap: 10px; }
  .trust :global(svg) { color: var(--sage); }
  .hero-visual { position: relative; max-width: 360px; width: 100%; justify-self: center; }
  .hero-mini { display: none; }
  @media (max-width: 999px) {
    .hero { padding-bottom: 40px; }
    .hero-visual { display: none; }
    .hero-head { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
    .hero-head h1 { margin: 0; flex: 1; }
    .hero-mini { display: block; flex: none; width: 92px; height: 92px; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 3px var(--white), 0 0 0 4px var(--line); }
    .hero-mini :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
    .hero h1 { font-size: clamp(1.7rem, 7vw, 2.6rem); }
    .hero .lead { margin-bottom: 24px; font-size: 1.02rem; }
    .trust { margin-top: 26px; padding-top: 18px; gap: 10px 22px; font-size: .86rem; }
  }
  .hero-img { aspect-ratio: 4 / 5; border-radius: 220px 220px var(--r) var(--r); }
  .hero-img :global(img) { object-position: 50% 50%; }
  .oslo-card { position: absolute; left: -24px; bottom: 32px; display: flex; align-items: center; gap: 12px; background: var(--white); border: 1px solid var(--line); border-radius: var(--r); padding: 12px 18px 12px 12px; box-shadow: var(--shadow); font-size: .85rem; color: var(--ink3); }
  .oslo-card strong { display: block; color: var(--ink); font-size: .95rem; }
  @media (max-width: 1000px) { .oslo-card { position: static; margin: 14px auto 0; width: fit-content; box-shadow: none; } }

  /* 1 bis. Bilan gratuit */
  .free-s { padding: clamp(48px, 6vw, 88px) 0 0; }
  .finder-s { padding: clamp(32px, 4vw, 56px) 0 clamp(56px, 7vw, 96px); }
  @media (min-width: 700px) { .free-more { display: none; } }
  .free-card { display: grid; gap: 36px; background: var(--white); border: 1px solid var(--sage); box-shadow: inset 0 0 0 1px var(--sage); border-radius: var(--r-lg); padding: clamp(26px, 4vw, 56px); }
  @media (min-width: 1000px) { .free-card { grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: start; } }
  .free-main h2 { font-size: clamp(1.8rem, 3.6vw, 2.8rem); margin-bottom: 18px; }
  .free-main .lead { margin-bottom: 24px; }
  .free-meta { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-wrap: wrap; gap: 10px; }
  .free-meta li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: var(--sage-l); color: var(--sage-d); font-size: .9rem; font-weight: 500; }
  .free-side { display: grid; gap: 28px; }
  .free-t { margin: 0 0 14px; font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--sage); }
  .free-next { padding: 20px 22px; border-radius: var(--r); background: var(--stone); }
  .free-next p:not(.free-t) { margin: 0; color: var(--ink2); font-size: .95rem; line-height: 1.6; }
  .free-next a { color: var(--sage-d); font-weight: 500; }
  @media (max-width: 520px) { .free-main .btns .btn { width: 100%; } }
  /* 2. Situations + guide */
  .sits { display: grid; gap: 16px; margin-top: 44px; }
  @media (min-width: 760px) { .sits { grid-template-columns: 1fr 1fr; gap: 20px; } }
  .sit { display: flex; flex-direction: column; gap: 18px; text-decoration: none; }
  .sit-head { display: flex; align-items: center; gap: 16px; }
  .sit h3 { margin: 0; font-size: 1.25rem; }
  /* le problème : des signes concrets, bien visibles */
  .signs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .signs li { padding: 7px 13px; border-radius: 999px; background: #f6e9e1; color: #8a4a2a; font-size: .9rem; font-weight: 500; line-height: 1.3; }
  /* la piste : l'explication, mise en avant à part */
  .piste { padding: 16px 18px; border-left: 3px solid var(--sage); border-radius: 4px var(--r) var(--r) 4px; background: var(--sage-l); }
  .piste summary { list-style: none; cursor: pointer; }
  .piste summary::-webkit-details-marker { display: none; }
  .piste summary::after { content: '+'; margin-left: auto; font-size: 1.1rem; font-weight: 400; letter-spacing: 0; }
  .piste[open] summary::after { content: '−'; }
  .piste[open] summary { margin-bottom: 6px; }
  .piste-l { display: flex; align-items: center; gap: 7px; margin: 0; font-size: .8rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sage-d); }
  .piste p:not(.piste-l) { margin: 0; color: var(--ink); font-size: .97rem; line-height: 1.55; }
  @media (max-width: 600px) {
    .sit { padding: 22px 18px; }
    .sit h3 { font-size: 1.15rem; }
    .signs li { font-size: .92rem; padding: 7px 12px; }
    .piste { padding: 14px 16px; }
    .piste p:not(.piste-l) { font-size: 1rem; }
    .sit-more { font-size: .95rem; padding: 6px 0; }
  }
  .sit-more { display: inline-flex; align-items: center; gap: 6px; font-size: .9rem; font-weight: 500; color: var(--sage); }
  .sit-more { text-decoration: none; align-self: flex-start; margin-top: auto; }
  .sit-more:hover { text-decoration: underline; }
  .finder { display: grid; gap: 32px; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(24px, 4vw, 48px); scroll-margin-top: 90px; }
  @media (min-width: 1000px) { .finder { grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: center; } }
  .fc-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--sage); }
  .finder-intro h3 { font-size: clamp(1.3rem, 2.2vw, 1.6rem); margin: 0 0 12px; }
  .finder-intro p { color: var(--ink2); font-size: .97rem; }
  .small { font-size: .9rem; }

  /* 3. Accompagnements */
  .offers { display: grid; gap: 20px; margin-top: 44px; }
  @media (min-width: 900px) { .offers { grid-template-columns: repeat(3, 1fr); } }
  .offer { display: flex; flex-direction: column; }
  .offer.first { border-color: var(--sage); box-shadow: inset 0 0 0 1px var(--sage); }
  .o-top { display: flex; justify-content: space-between; align-items: center; }
  .o-n { font-family: var(--serif); font-style: italic; font-size: 2rem; color: var(--sage); line-height: 1; }
  .o-tag { margin: 24px 0 6px; font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sage); }
  .offer h3 { margin: 0 0 12px; font-size: 1.35rem; }
  .o-txt { flex: 1; color: var(--ink2); font-size: .97rem; margin: 0 0 22px; }
  .more-p { margin-top: 40px; }

  /* 5. Avis */
  .reviews { display: grid; gap: 20px; margin-top: 44px; }
  @media (min-width: 900px) { .reviews { grid-template-columns: repeat(3, 1fr); } .reviews.n2 { grid-template-columns: 1fr 1fr; } .reviews.n1 { grid-template-columns: 1fr; max-width: 760px; } }
  .reviews.n1 blockquote p { font-size: 1.12rem; }
  .review { margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .r-top { display: flex; justify-content: space-between; align-items: center; }
  .stars { display: inline-flex; gap: 2px; color: #e0a526; }
  .stars :global(svg) { fill: currentColor; }
  .g { font-size: .78rem; color: var(--ink3); }
  .ex-tag { font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #8a5a00; background: #fff1d6; padding: 4px 9px; border-radius: 999px; }
  blockquote { margin: 0; flex: 1; }
  blockquote p { margin: 0; font-size: 1.02rem; line-height: 1.6; }
  figcaption { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .95rem; }
  figcaption small { display: block; color: var(--ink3); font-size: .85rem; }
  .ini { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--sage-l); color: var(--sage-d); font-family: var(--display); font-weight: 600; }

  /* 6. Final */
